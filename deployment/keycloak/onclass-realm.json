      { "name": "admin" },
      { "name": "student" }
    ]
  },
  "users": [
    {
      "username": "testuser",
      "enabled": true,
      "email": "testuser@onclass.local",
      "emailVerified": true,
      "firstName": "Test",
      "lastName": "User",
      "credentials": [
        { "type": "password", "value": "testuser123", "temporary": false }
      ],
      "realmRoles": ["student"]
    }
  ]
